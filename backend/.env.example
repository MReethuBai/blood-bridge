# ==========================================
# IntelLearn AI Backend Configuration Template
# ==========================================

# Application Metadata
PROJECT_NAME="IntelLearn AI Backend"
API_V1_STR="/api/v1"

# JWT Security Credentials
SECRET_KEY="your_secret_jwt_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URIs
POSTGRES_URI="postgresql+asyncpg://user:password@localhost:5432/intellearn_db"
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="intellearn_ai"
REDIS_URI="redis://localhost:6379/0"

# File Upload Configuration
MAX_UPLOAD_SIZE_BYTES=104857600
UPLOAD_DIR="./uploads"

# AI Model Credentials
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-3.5-flash"
OPENAI_API_KEY="your_openai_api_key_here"
OLLAMA_BASE_URL="http://localhost:11434"
